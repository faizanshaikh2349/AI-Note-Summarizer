<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Profile Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/header_bg"
            android:paddingTop="@dimen/spacing_xxl"
            android:paddingBottom="@dimen/spacing_xl"
            android:gravity="center_horizontal">

            <!-- Avatar circle -->
            <FrameLayout
                android:layout_width="@dimen/profile_avatar_size"
                android:layout_height="@dimen/profile_avatar_size"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/header_accent">
                <ImageView
                    android:layout_width="@dimen/profile_avatar_inner"
                    android:layout_height="@dimen/profile_avatar_inner"
                    android:layout_gravity="center"
                    android:src="@drawable/profile"
                    android:contentDescription="Avatar"/>
            </FrameLayout>

            <!-- Display name -->
            <TextView
                android:id="@+id/tvProfileDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="@color/header_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <!-- Email -->
            <TextView
                android:id="@+id/profileEmailText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@color/header_text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="@dimen/spacing_xs"/>

            <!-- Member since -->
            <TextView
                android:id="@+id/tvMemberSince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Member since today"
                android:textColor="@color/header_text_tertiary"
                android:textSize="11sp"
                android:layout_marginTop="@dimen/spacing_xs"/>

        </LinearLayout>

        <!-- ── Stats Row ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvProfileNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/stat_number_size"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notes"
                        android:textSize="@dimen/stat_label_size"
                        android:textColor="@color/text_tertiary"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/divider_color_light"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvProfileSummaries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/stat_number_size"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Summaries"
                        android:textSize="@dimen/stat_label_size"
                        android:textColor="@color/text_tertiary"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/divider_color_light"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvProfileChats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/stat_number_size"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Chats"
                        android:textSize="@dimen/stat_label_size"
                        android:textColor="@color/text_tertiary"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Account Section ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT"
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Email row -->
                <LinearLayout
                    android:id="@+id/rowEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:clickable="false"
                    android:focusable="false">
                    <TextView android:layout_width="@dimen/icon_size_md" android:layout_height="@dimen/icon_size_md"
                        android:text="📧" android:textSize="16sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Email" android:textSize="13sp" android:textColor="@color/text_tertiary"/>
                        <TextView android:id="@+id/tvAccountEmail"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="15sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_color_light" android:layout_marginStart="@dimen/profile_row_divider_margin_start"/>

                <!-- Change Password row -->
                <LinearLayout
                    android:id="@+id/rowChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="@dimen/icon_size_md" android:layout_height="@dimen/icon_size_md"
                        android:text="🔒" android:textSize="16sp" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Change Password"
                        android:textSize="15sp" android:textColor="@color/text_primary"
                        android:layout_marginStart="12dp"/>
                    <ImageView android:layout_width="@dimen/icon_size_sm" android:layout_height="@dimen/icon_size_sm"
                        android:src="@drawable/ic_back" app:tint="@color/text_disabled"
                        android:rotation="180" android:contentDescription="Arrow"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_color_light" android:layout_marginStart="@dimen/profile_row_divider_margin_start"/>

                <!-- Session info row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <TextView android:layout_width="@dimen/icon_size_md" android:layout_height="@dimen/icon_size_md"
                        android:text="🕐" android:textSize="16sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Logged in" android:textSize="13sp" android:textColor="@color/text_tertiary"/>
                        <TextView android:id="@+id/tvLoginTime"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="—" android:textSize="15sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Preferences Section ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREFERENCES"
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Notifications -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md">
                    <TextView android:layout_width="@dimen/icon_size_md" android:layout_height="@dimen/icon_size_md"
                        android:text="🔔" android:textSize="16sp" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Notifications"
                        android:textSize="15sp" android:textColor="@color/text_primary"
                        android:layout_marginStart="12dp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/primary"
                        app:trackTint="@color/primary_container"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_color_light" android:layout_marginStart="@dimen/profile_row_divider_margin_start"/>

                <!-- AI Model row -->
                <LinearLayout
                    android:id="@+id/rowAiModel"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="@dimen/icon_size_md" android:layout_height="@dimen/icon_size_md"
                        android:text="🧠" android:textSize="16sp" android:gravity="center"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="AI Model" android:textSize="15sp" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Llama 3.3 70B (Groq)" android:textSize="12sp" android:textColor="@color/text_tertiary"/>
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/icon_size_sm" android:layout_height="@dimen/icon_size_sm"
                        android:src="@drawable/ic_back" app:tint="@color/text_disabled"
                        android:rotation="180" android:contentDescription="Arrow"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Danger Zone ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT ACTIONS"
            style="@style/TextAppearance.App.SectionLabel"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Clear chat history -->
                <LinearLayout
                    android:id="@+id/rowClearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="@dimen/icon_size_md" android:layout_height="@dimen/icon_size_md"
                        android:text="🗑️" android:textSize="16sp" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Clear Chat History"
                        android:textSize="15sp" android:textColor="@color/danger_text"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider_color_light" android:layout_marginStart="@dimen/profile_row_divider_margin_start"/>

                <!-- Logout -->
                <LinearLayout
                    android:id="@+id/rowLogout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="@dimen/icon_size_md" android:layout_height="@dimen/icon_size_md"
                        android:text="🚪" android:textSize="16sp" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Log Out"
                        android:textSize="15sp" android:textColor="@color/danger_text"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>