<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Header Banner ── -->
            <LinearLayout
                android:id="@+id/headerBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/header_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="@dimen/spacing_xxl"
                android:paddingBottom="@dimen/spacing_xl">

                <!-- Top row: greeting + avatar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good morning 👋"
                            android:textColor="@color/header_text_secondary"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Notes"
                            android:textColor="@color/header_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="@dimen/spacing_xxs"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivProfile"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/profile"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/header_accent"
                        android:contentDescription="Profile"/>
                </LinearLayout>

                <!-- Search bar -->
                <LinearLayout
                    android:id="@+id/searchBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/search_bar_height"
                    android:layout_marginTop="20dp"
                    android:background="@color/header_bg_secondary"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/header_text_tertiary"
                        android:contentDescription="Search"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Search your notes..."
                        android:textColor="@color/header_text_tertiary"
                        android:textSize="14sp"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>

                <!-- ── Dashboard Counters (live from Firebase) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="fill_vertical">

                    <!-- ① Flashcards -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_stat_card_purple"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🃏"
                            android:textSize="22sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvStatFlashcards"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/header_text_primary"
                            android:textSize="@dimen/stat_number_size"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Flashcards"
                            android:textColor="@color/stat_label_color"
                            android:textSize="@dimen/stat_label_size" />
                    </LinearLayout>

                    <!-- ② Summaries -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_stat_card_blue"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝"
                            android:textSize="22sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvStatSummaries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/header_text_primary"
                            android:textSize="@dimen/stat_number_size"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Summaries"
                            android:textColor="@color/stat_label_color"
                            android:textSize="@dimen/stat_label_size" />
                    </LinearLayout>

                    <!-- ③ AI Chats -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_stat_card_teal"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🤖"
                            android:textSize="22sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvStatChats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/header_text_primary"
                            android:textSize="@dimen/stat_number_size"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI Chats"
                            android:textColor="@color/stat_label_color"
                            android:textSize="@dimen/stat_label_size" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- ── Body content ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Start with AI card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStartAI"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/card_corner_radius_large"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✨ Summarize with AI"
                                android:textColor="@color/on_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Paste notes and get instant\nsummaries powered by Groq"
                                android:textColor="@color/primary_container"
                                android:textSize="12sp"
                                android:layout_marginTop="@dimen/spacing_xs"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStart"
                                style="@style/AppButton.OnDark"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/button_height_small"
                                android:text="Start Now"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:layout_marginTop="12dp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/ai_logo"
                            android:scaleType="centerCrop"
                            android:contentDescription="AI"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Quick Actions title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    style="@style/TextAppearance.App.TitleMedium"
                    android:layout_marginBottom="12dp"/>

                <!-- Quick action cards row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <!-- Chat AI -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardChatAI"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation"
                        app:cardBackgroundColor="@color/card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md"
                            android:gravity="center">

                            <TextView
                                android:layout_width="@dimen/icon_size_lg"
                                android:layout_height="@dimen/icon_size_lg"
                                android:text="🤖"
                                android:textSize="28sp"
                                android:gravity="center"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chat AI"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="@dimen/spacing_sm"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ask anything"
                                android:textSize="11sp"
                                android:textColor="@color/text_tertiary"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- History -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHistory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation"
                        app:cardBackgroundColor="@color/card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md"
                            android:gravity="center">

                            <TextView
                                android:layout_width="@dimen/icon_size_lg"
                                android:layout_height="@dimen/icon_size_lg"
                                android:text="📋"
                                android:textSize="28sp"
                                android:gravity="center"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="History"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="@dimen/spacing_sm"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Past summaries"
                                android:textSize="11sp"
                                android:textColor="@color/text_tertiary"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bookmarks -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBookmarks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/card_elevation"
                        app:cardBackgroundColor="@color/card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md"
                            android:gravity="center">

                            <TextView
                                android:layout_width="@dimen/icon_size_lg"
                                android:layout_height="@dimen/icon_size_lg"
                                android:text="🔖"
                                android:textSize="28sp"
                                android:gravity="center"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saved"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="@dimen/spacing_sm"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bookmarks"
                                android:textSize="11sp"
                                android:textColor="@color/text_tertiary"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Tips section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to use"
                    style="@style/TextAppearance.App.TitleMedium"
                    android:layout_marginBottom="12dp"/>

                <!-- Tip 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="1️⃣"
                            android:textSize="22sp"
                            android:gravity="center"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Open AI Chat"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap Start Now or the ✚ button below"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tip 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="2️⃣"
                            android:textSize="22sp"
                            android:gravity="center"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Paste or type your notes"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="You can also use the microphone to dictate"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tip 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/bottom_nav_height"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_bg">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="3️⃣"
                            android:textSize="22sp"
                            android:gravity="center"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Get your AI summary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Choose Short, Detailed, or Bullet format"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>