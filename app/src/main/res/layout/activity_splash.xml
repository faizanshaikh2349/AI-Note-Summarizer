<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient_bg">

    <!-- Hero illustration — AI/Notes relevant image -->
    <ImageView
        android:id="@+id/splashHeroImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ai_logo_fin"
        android:scaleType="centerCrop"
        android:contentDescription="AI Notes"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splashLottie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintVertical_chainStyle="packed"/>

    <!-- Lottie animation below hero -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/splashLottie"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:lottie_rawRes="@raw/loginanimation"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/splashHeroImage"
        app:layout_constraintBottom_toTopOf="@id/appNameText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/appNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/auth_text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/splashLottie"
        app:layout_constraintBottom_toTopOf="@id/taglineText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/taglineText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/splash_tagline"
        android:textColor="@color/auth_text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/appNameText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Powered by label at bottom -->
    <TextView
        android:id="@+id/poweredByText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Powered by Groq AI"
        android:textColor="@color/header_text_tertiary"
        android:textSize="11sp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
